     "by": "role",
     "role": "button",
     "value": "Save note",
     "exact": true
    },
    "description": "Click button \"Save note\""
   },
   {
    "action": "wait",
    "ms": 0,
    "until": "visible",
    "locator": {
     "by": "text",
     "value": "120"
    },
    "description": "Wait until text \"120\" is visible"
   },
   {
    "action": "assert",
    "check": "visible",
    "locator": {
     "by": "role",
     "role": "alert"
    },
    "source": "expected:2",
    "description": "Verify visible of alert \"\""
   },
   {
    "action": "navigate",
    "url": "/notes",
    "description": "Open /notes"
   },
   {
    "action": "assert",
    "check": "count",
    "locator": {
     "by": "role",
     "role": "listitem"
    },
    "expected": 5,
    "source": "expected:2",
    "description": "Verify count of listitem \"\" = 5"
   }
  ],
  "scenario": {
   "description": "Create a note with a 120-character title and confirm it is saved. Then try a 121-character title and confirm it is refused and no note is added.",
   "preconditions": [
    "Signed in as the test account"
   ],
   "requiredData": [
    "120-character and 121-character titles tagged qamosn with generated data"
   ],
   "expectedResults": [
    "The 120-character title is saved and its note page heading shows the full 120-character title (requirement 3.5)",
    "With a 121-character title the form shows an error message and no note is created, so the notes list count is unchanged (requirement 3.5)"
   ]
  }
