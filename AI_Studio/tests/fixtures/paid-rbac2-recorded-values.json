 "WEB-046": {
  "steps": [
   {
    "action": "navigate",
    "url": "/notes",
    "description": "Open /notes"
   },
   {
    "action": "fill",
    "locator": {
     "by": "label",
     "value": "Email"
    },
    "value": "{{credentials.username}}",
    "description": "Sign in as test user"
   },
   {
    "action": "fill",
    "locator": {
     "by": "label",
     "value": "Password"
    },
    "value": "{{credentials.password}}",
    "description": "Enter \"{{credentials.password}}\" into label \"Password\""
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "button",
     "value": "Sign in",
     "exact": true
    },
    "description": "Submit sign-in form"
   },
   {
    "action": "wait",
    "ms": 0,
    "until": "url",
    "value": "/notes",
    "locator": {
     "by": "text",
     "value": "Notes"
    },
    "description": "Wait until the address matches \"/notes\""
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "navigation",
     "value": "Main"
    },
    "description": "Scope to main navigation"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "link",
     "value": "Notes",
     "exact": true
    },
    "description": "Return to Notes list"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "navigation",
     "value": "Main"
    },
    "description": "placeholder"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "link",
     "value": "Notes",
     "exact": true
    },
    "description": "Return to Notes list"
   },
   {
    "action": "assert",
    "check": "count",
    "locator": {
     "by": "css",
     "value": "main li"
    },
    "expected": 34,
    "source": "expected:2",
    "description": "Record the notes count before the attempt (3 shown + 31 more)"
   },
   {
    "action": "click",
    "locator": {
     "by": "css",
     "value": "main p a[href='/notes/new']"
    },
    "description": "Open new note form"
   },
   {
    "action": "fill",
    "locator": {
     "by": "label",
     "value": "Title"
    },
    "value": "   ",
    "description": "Whitespace-only title"
   },
   {
    "action": "fill",
    "locator": {
     "by": "label",
     "value": "Text"
    },
    "value": "qamosn check",
    "description": "Required body text"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "button",
     "value": "Save note",
     "exact": true
    },
    "description": "Submit the note with a whitespace title"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "link",
     "value": "Notes",
     "exact": true
    },
    "description": "Open Notes list from main navigation"
   },
   {
    "action": "assert",
    "check": "count",
    "locator": {
     "by": "css",
     "value": "main li"
    },
    "expected": 34,
    "source": "expected:2",
    "description": "Notes list count must be unchanged (34)"
   }
  ],
  "scenario": {
   "description": "Enters spaces as the title, submits the form, and checks that the title error appears and the notes list count is unchanged.",
   "preconditions": [
    "Signed in as the test user ana",
    "Note list count noted before the attempt"
   ],
   "requiredData": [
    "title of spaces only",
    "text qamosn check"
   ],
   "expectedResults": [
    "Clicking Save note with a title of spaces keeps the browser on /notes/new and shows the message Give the note a title. (requirement 3.4)",
    "After clicking Notes in the main navigation, the list shows the same number of notes as before the attempt, with no new entry (requirement 3.4)"
   ]
  }
 },
