{
  "openapi": "3.1.0",
  "info": {
    "title": "Practice Store API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/auth/signup": {
      "post": {
        "summary": "Create a customer account and sign in",
        "tags": [
          "auth"
        ],
        "operationId": "post_auth_signup",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password",
                  "age",
                  "country",
                  "terms"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "title": "Full name",
                    "minLength": 2,
                    "maxLength": 60,
                    "x-message": "Enter a name of 2 to 60 characters."
                  },
                  "email": {
                    "type": "string",
                    "title": "Email",
                    "format": "email",
                    "x-message": "Enter a valid email address."
                  },
                  "password": {
                    "type": "string",
                    "title": "Password",
                    "pattern": "^(?=.*[A-Za-z])(?=.*\\d)(?=.*[^A-Za-z0-9]).{8,128}$",
                    "x-message": "Use at least 8 characters with a letter, a number and a symbol."
                  },
                  "confirmPassword": {
                    "type": "string",
                    "title": "Confirm password",
                    "maxLength": 128,
                    "x-message": "The passwords do not match."
                  },
                  "age": {
                    "type": "integer",
                    "title": "Age",
                    "minimum": 18,
                    "maximum": 120,
                    "x-message": "Enter an age from 18 to 120."
                  },
                  "country": {
                    "type": "string",
                    "title": "Country",
                    "enum": [
                      "IN",
                      "GB",
                      "US",
                      "DE",
                      "FR",
                      "JP",
                      "AU"
                    ],
                    "x-message": "Choose a country."
                  },
                  "terms": {
                    "type": "boolean",
                    "title": "I accept the terms",
                    "x-message": "You must accept the terms."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict with the current state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserResult": {
        "type": "object",
        "properties": {
          "user": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/User"
              },
              {
                "type": "null"
              }
            ]
          },
          "next": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "role"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "customer",
              "admin"
            ]
          },
          "twoFactor": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "totp",
              "email",
              null
            ]
          },
          "hasAvatar": {
            "type": "boolean"
          },
          "avatarUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "field": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
