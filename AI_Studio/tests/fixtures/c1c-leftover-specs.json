 "WEB-020": {
  "title": "Each product detail page matches its catalogue entry",
  "steps": [
   {
    "action": "navigate",
    "url": "/",
    "description": "Open /"
   },
   {
    "action": "remember",
    "locator": {
     "by": "role",
     "role": "listitem",
     "filter": {
      "hasText": "Headphones"
     }
    },
    "name": "cataloguePrice",
    "from": "text",
    "description": "Record the Headphones card on the catalogue before opening it"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "link",
     "value": "Headphones",
     "exact": true
    },
    "description": "Open the Headphones product page from the catalogue"
   },
   {
    "action": "assert",
    "check": "exactText",
    "locator": {
     "by": "role",
     "role": "heading",
     "value": "Headphones",
     "exact": true
    },
    "expected": "Headphones",
    "source": "expected:1",
    "description": "Product page heading reads Headphones"
   },
   {
    "action": "assert",
    "check": "visible",
    "locator": {
     "by": "text",
     "value": "$59.99",
     "exact": true
    },
    "source": "expected:2",
    "description": "Product page shows the price $59.99"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "link",
     "value": "Products",
     "exact": true
    },
    "description": "Return to the catalogue to confirm the Headphones card price"
   },
   {
    "action": "assert",
    "check": "text",
    "locator": {
     "by": "role",
     "role": "listitem",
     "filter": {
      "hasText": "Headphones"
     }
    },
    "expected": "$59.99",
    "source": "expected:2",
    "description": "Catalogue card shows Headphones at $59.99"
   }
  ]
 },
 "WEB-021": {
  "title": "Add to cart rejects zero and negative quantity",
  "steps": [
   {
    "action": "navigate",
    "url": "/products/p2",
    "description": "Open /products/p2"
   },
   {
    "action": "navigate",
    "url": "/login",
    "description": "Open /login"
   },
   {
    "action": "fill",
    "locator": {
     "by": "label",
     "value": "Email"
    },
    "value": "{{credentials.username}}",
    "description": "Enter test account email"
   },
   {
    "action": "fill",
    "locator": {
     "by": "label",
     "value": "Password"
    },
    "value": "{{credentials.password}}",
    "description": "Enter test account password"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "button",
     "value": "Sign in"
    },
    "description": "Sign in"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "navigation",
     "value": "Main"
    },
    "description": "Open the cart to confirm it is empty"
   },
   {
    "action": "navigate",
    "url": "/cart",
    "description": "Open /cart"
   },
   {
    "action": "navigate",
    "url": "/products/p2",
    "description": "Open /products/p2"
   },
   {
    "action": "fill",
    "locator": {
     "by": "role",
     "role": "spinbutton",
     "value": "Quantity"
    },
    "value": "0",
    "description": "Enter quantity 0"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "button",
     "value": "Add to cart"
    },
    "description": "Try adding with quantity 0"
   },
   {
    "action": "fill",
    "locator": {
     "by": "role",
     "role": "spinbutton",
     "value": "Quantity"
    },
    "value": "-1",
    "description": "Enter quantity -1"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "button",
     "value": "Add to cart"
    },
    "description": "Try adding with quantity -1"
   },
   {
    "action": "assert",
    "check": "visible",
    "locator": {
     "by": "role",
     "role": "alert"
    },
    "expected": "Choose a quantity of at least 1.",
    "source": "expected:1",
    "description": "Validation message shows quantity must be at least 1"
   },
   {
    "action": "assert",
    "check": "notText",
    "locator": {
     "by": "role",
     "role": "navigation",
     "value": "Main"
    },
    "expected": 1,
    "source": "expected:2",
    "description": "Cart badge shows no items"
   },
   {
    "action": "assert",
    "check": "exactText",
    "locator": {
     "by": "role",
     "role": "link",
     "value": "Cart",
     "exact": true
    },
    "expected": "Cart",
    "source": "expected:2",
    "description": "Cart link has no count badge"
   },
   {
    "action": "assert",
    "check": "notText",
    "locator": {
     "by": "role",
     "role": "main"
    },
    "expected": "Server error",
    "source": "expected:1",
    "description": "Fail if the page data comes back as a server error"
   },
   {
    "action": "assert",
    "check": "visible",
    "locator": {
     "by": "role",
     "role": "heading",
     "value": "Desk Lamp"
    },
    "source": "expected:1",
    "description": "Fail if the product data comes back empty"
   },
   {
    "action": "assert",
    "check": "value",
    "locator": {
     "by": "role",
     "role": "spinbutton",
     "value": "Quantity"
    },
    "expected": -1,
    "source": "expected:1",
    "description": "The rejected quantity stays in the field"
   },
   {
    "action": "assert",
    "check": "notText",
    "locator": {
     "by": "role",
     "role": "link",
     "value": "Cart"
    },
    "expected": "Cart 1",
    "source": "expected:2",
    "description": "Cart badge must not show an item after the rejected add"
   },
   {
    "action": "assert",
    "check": "exactText",
    "locator": {
     "by": "text",
     "value": "Choose a quantity of at least 1.",
     "exact": true
    },
    "expected": "Choose a quantity of at least 1.",
    "source": "expected:1",
    "description": "Validation message must read exactly as specified"
   }
  ]
 },
