 "WEB-028": {
  "title": "Cart persists after sign out and sign in again",
  "steps": [
   {
    "action": "navigate",
    "url": "/products/p4",
    "description": "Open /products/p4"
   },
   {
    "action": "navigate",
    "url": "http://127.0.0.1:5291/login",
    "description": "Open http://127.0.0.1:5291/login"
   },
   {
    "action": "fill",
    "locator": {
     "by": "label",
     "value": "Email"
    },
    "value": "{{credentials.username}}",
    "description": "Enter account email"
   },
   {
    "action": "fill",
    "locator": {
     "by": "label",
     "value": "Password"
    },
    "value": "{{credentials.password}}",
    "description": "Enter account password"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "button",
     "value": "Sign in",
     "exact": true
    },
    "description": "Sign in"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "link",
     "value": "Cart",
     "exact": true
    },
    "description": "Open the cart to check it is empty"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "button",
     "value": "Remove",
     "exact": true
    },
    "description": "Empty the cart before the test"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "link",
     "value": "Products",
     "exact": true
    },
    "description": "Go to products"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "link",
     "value": "Headphones",
     "exact": true
    },
    "description": "Open Headphones product"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "button",
     "value": "Add to cart",
     "exact": true
    },
    "description": "Add Headphones (quantity 1) to the cart"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "button",
     "value": "Sign out",
     "exact": true
    },
    "description": "Sign out"
   },
   {
    "action": "fill",
    "locator": {
     "by": "label",
     "value": "Email"
    },
    "value": "{{credentials.username}}",
    "description": "Enter account email to sign back in"
   },
   {
    "action": "fill",
    "locator": {
     "by": "label",
     "value": "Password"
    },
    "value": "{{credentials.password}}",
    "description": "Enter account password"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "button",
     "value": "Sign in",
     "exact": true
    },
    "description": "Sign back in"
   },
   {
    "action": "click",
    "locator": {
     "by": "role",
     "role": "link",
     "value": "Cart",
     "exact": true
    },
    "description": "Open the cart after signing back in"
   },
   {
    "action": "assert",
    "check": "visible",
    "locator": {
     "by": "role",
     "role": "row",
     "value": "Headphones",
     "exact": false
    },
    "source": "expected:1",
    "description": "Cart page lists Headphones"
   }
  ]
 },
