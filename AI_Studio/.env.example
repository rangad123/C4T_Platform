# --- LLM (required for web test generation) -------------------------------
LLM_PROVIDER=anthropic            # anthropic | openai | google | openai-compatible
# LLM_MODEL=claude-sonnet-5-5     # optional override
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1   # for openai-compatible (local server)
# OpenRouter: LLM_PROVIDER=openai-compatible, LLM_BASE_URL=https://openrouter.ai/api/v1,
#             LLM_MODEL=anthropic/claude-sonnet-5.5, LLM_API_KEY=sk-or-...
# Reliability (docs/features/ai-model-reliability.md). Fallback models are asked in order when the main
# model is unavailable or out of credit; another provider is written provider:model and needs its own key.
# LLM_FALLBACK_MODELS=claude-haiku-4-5, openai:gpt-5.4
# LLM_RETRY_ATTEMPTS=6           # requests per model for one call (1-10)
# LLM_TIMEOUT_MS=120000          # time limit of one request
# LLM_CALL_DEADLINE_MS=600000    # time limit of one call, retries and fallbacks included
# LLM_COMPACT_SNAPSHOTS=on        # smaller page snapshots for the AI (docs/features/smaller-snapshots.md); off = full snapshots. Settings wins.
# LLM_PROMPT_CACHE=on            # prompt caching (docs/features/prompt-caching.md); off = no cache markers. Settings wins.
# LLM_MODEL_FAST=claude-haiku-4-5 # fast model for routine steps (docs/features/model-routing.md); empty = main model does everything. Settings wins.
# LLM_MODEL_FAST_IMAGES=false     # true = calls with screenshots may use the fast model too
# LLM_DETERMINISTIC_REPAIR=on     # repair a missing element without AI first (docs/features/repair-and-reuse-without-ai.md). Settings wins.
# LLM_EXPLORATION_REUSE=on        # unchanged pages are not sent to the AI again on a re-exploration (same doc). Settings wins.

# --- Server ----------------------------------------------------------------
PORT=4000
HOST=127.0.0.1
# API_KEY=change-me               # require x-api-key on /api (set this if HOST is not loopback)
# SECRET_KEY=at-least-16-chars    # encrypts stored credentials; default: generated key file in DATA_DIR
# SECRET_KEY_REQUIRED=true          # hosted installs: refuse to start without SECRET_KEY instead of making a key file
DATA_DIR=./data
WORKER_EMBEDDED=true
CONCURRENCY=3
MAX_REPAIR_ATTEMPTS=2
# BLOCK_PRIVATE_TARGETS=true      # refuse loopback/private-network targets (hosted deployments)

# --- Security assessment (passive, read-only; docs/features/security-assessment.md) ---
# SECURITY_ASSESSMENT=on            # off: the module's pages and /api/v1/security routes are gone (functional testing unchanged)
# SECURITY_ALLOW_PRIVATE_TARGETS=false  # true: assessments may reach loopback/private networks (cloud metadata stays refused)
# SECURITY_RETENTION_DAYS=365       # finished assessments and their evidence are removed after this many days
# SECURITY_MAX_REQUESTS=2000        # most requests one assessment may send
# SECURITY_MAX_RESPONSE_BYTES=5242880  # most bytes read from one response
# SECURITY_ASSESSMENT_MINUTES=30    # time limit of one assessment
# SECURITY_USE_PROXY=off            # on: assessments go through HTTPS_PROXY/HTTP_PROXY (the proxy then resolves names itself)
# SECURITY_PROXY_ALLOW_PRIVATE=false  # true: that proxy may be on a loopback/private address (cloud metadata stays refused)

# --- External security scanners (docs/features/security-scanners.md) ---
# Nothing below switches a scanner on by itself: SECURITY_SCANNERS must name it AND an editor must allow it for the project.
# SECURITY_SCANNERS=zap,nuclei    # the tools that may run at all (zap, nuclei, schemathesis, promptfoo). Default: none
# SECURITY_SCANNER_MAX_MINUTES=20  # time limit of one scanner run (1-600)
# SECURITY_SCANNER_REQUEST_BUDGET=3000  # most requests one run may send, across every tool (10-200000)
# SECURITY_SCANNER_MAX_RPS=5       # hard ceiling for the rate handed to a tool (1-50); the application's own limit wins when smaller
# SECURITY_SCANNER_BIN_DIRS=       # extra directories searched for scanner binaries (';' separated on Windows)
# SECURITY_ZAP_URL=http://127.0.0.1:8090  # base address of the ZAP daemon (a separate service; ZAP needs both this and the key)
#   ZAP 2.16+ closes its API by default. Start it with its own documented -host/-port flags:
#     zap.sh -daemon -config api.enabled=true -config api.secure=false -config api.key=<the same key> -host 127.0.0.1 -port 8090
#   (zap.bat on Windows.) Do NOT try to set the API address with -config api.addrs.addr.name / .regex: ZAP's -config parser
#   writes that string into the BOOLEAN 'regex' element, and the API then fails to load its permitted addresses on every start
#   and answers nothing. Verified on 2.17.0; -host/-port is the documented way and needs no repair afterwards.
# SECURITY_ZAP_API_KEY=            # server-side only: never returned by the API, never sent to the browser
# SECURITY_NUCLEI_PATH=            # path to the nuclei binary (auto-detected when empty)
# SECURITY_NUCLEI_TEMPLATES=       # the reviewed template directory; templates are chosen from here only
# SECURITY_NUCLEI_CONCURRENCY=5    # how many templates at once (1-50)
# SECURITY_SCHEMATHESIS_PATH=      # path to the schemathesis command (auto-detected when empty)
# SECURITY_PROMPTFOO_PATH=         # path to the promptfoo command (auto-detected when empty)

# --- Scheduled runs and alerts ---------------------------------------------
# SCHEDULER_ENABLED=true            # run scheduled tests (Runs → Schedules)
# SCHEDULER_TICK_MS=30000           # how often to look for due schedules
# PUBLIC_URL=https://tests.example.com   # how people reach this platform; alerts/issues link back to it
# Sign-in cookies are Secure when PUBLIC_URL is https. Behind a proxy that ends TLS and no PUBLIC_URL: COOKIE_SECURE=true
# With PUBLIC_URL set, X-Forwarded-For/-Proto from a proxy on this machine (127.0.0.1) are believed, so rate limits see each visitor.
# (people, roles and single sign-on are set up in the app, Settings -> People; see docs/features/people-and-access.md)
# COOKIE_SECURE=true
# Sign in with the crowd4test.com session instead (aistudio.crowd4test.com; docs/features/crowd4test-sign-in.md). Both or neither.
# On the same server as the Crowd4Test API, which uses port 4000, give this platform another PORT (4100, say).
# C4T_API_ORIGIN=http://127.0.0.1:4000     # the Crowd4Test API, as this server reaches it
# C4T_SITE_URL=https://crowd4test.com      # crowd4test.com, as people reach it
# Crowd4Test's service endpoints: organisation names, linking a Crowd4Test project, adding people who never opened AI Studio.
# The same value as AI_STUDIO_SERVICE_TOKEN in C4T_Platform/api/.env (at least 32 characters). Off when unset.
# C4T_SERVICE_TOKEN=
# ALERT_MIN_SEVERITY=low            # critical|high|medium|low: lowest finding that triggers alerts
# Mail server for email alert channels (a channel can also carry its own settings; its password is stored encrypted)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                     # 465 implies a secure connection from the start
# SMTP_SECURE=false                 # true = TLS from the start; false = STARTTLS when the server offers it
# SMTP_USER=alerts@example.com      # leave out if the server needs no sign-in
# SMTP_PASSWORD=
# SMTP_FROM=alerts@example.com      # the sender address on every alert mail

# --- Mobile tests (Android emulator; set up with `npx taqwright install --with-avd`) ---
# MOBILE_AVD=taqwright_api34        # default: the first emulator found
# PHONE_EXPLORER=map                 # map (default): the explorer maps the app itself and asks the AI only for forms, when stuck and to name screens; ai: the AI chooses every action (earlier explorer, many more AI calls)
# MOBILE_KEEP_EMULATOR=true         # leave the emulator running after a job (holds ~2 GB of RAM)

# --- Windows desktop tests (the platform host must be Windows, in a signed-in session, not run as administrator) ---
# Applications desktop tests may start on THIS computer: full paths or program names, separated by ;. Nothing is allowed by default,
# and command shells and script hosts (cmd, powershell, wscript, ...) are never allowed, even when listed. A runner agent keeps its own list (--allow-app).
# DESKTOP_ALLOWED_APPS=C:WindowsSystem32calc.exe;C:Program FilesMyAppMyApp.exe

# --- Hand-written (custom) tests ---
# A person can take over a generated test, write one from scratch or import one from Git. These scripts are arbitrary code, so they run on
# this server ONLY when this is "true" (default off: running user-supplied code on the server). Otherwise they run on a runner agent that
# its owner started with --allow-custom-scripts. Leave it off unless everyone who can edit tests is trusted with this machine.
# It has no effect unless API_KEY is also set (without a key anyone who can reach the port could run code here); the server says so at start.
# Never turn it on for authors you do not trust: the script check catches mistakes, it does not stop an attacker.
# ALLOW_CUSTOM_SCRIPTS=true                # refused when Crowd4Test sign-in (C4T_API_ORIGIN) is on

# --- Adapter plug-ins (a testing framework added as code; off by default) ---
# A plug-in is code that runs inside this server with all its power (it can read every secret a run is given). Only load plug-ins you wrote or reviewed.
# It has no effect unless API_KEY is also set; the server says so at start. ADAPTER_PLUGINS lists FULL paths separated by semicolons: a folder with plugin.json and adapter.mjs, or a .mjs file with a <name>.plugin.json beside it.
# See examples/adapter-plugin/README.md and docs/features/adapter-plugins.md.
# ALLOW_ADAPTER_PLUGINS=true
# ADAPTER_PLUGINS=/full/path/to/examples/adapter-plugin

# --- AI usage limits (off unless set; limits set in Settings, AI usage, take precedence) ---
# AI_MONTHLY_TOKEN_LIMIT=5000000   # tokens (input + output) all projects may use per calendar month (UTC); AI work stops cleanly at the limit
# AI_JOB_TOKEN_LIMIT=400000        # tokens one job may use; the job stops cleanly and keeps the tests it already made

# --- Storage -----------------------------------------------------------------
# Remove screenshots, recordings and traces of passed runs after this many days (7-365), for projects that have not set their own
# policy. Failed runs are kept three times as long. Off unless set. Tests, history, issues and releases are never removed.
# Each project can switch retention on, off or change it under Storage and backup.
# RETENTION_DEFAULT_DAYS=30

# --- Production hosting (see deploy/README.md and docs/features/production-hosting.md) ---
# DOMAIN=tests.example.com          # used by deploy/Caddyfile for the HTTPS certificate (deploy/docker-compose.prod.yml)
# LOG_FORMAT=json                   # one JSON object per log line, secrets removed (default: the usual text lines)
# METRICS_TOKEN=                    # 16+ characters: lets Prometheus read /metrics with "Authorization: Bearer <token>" (the API key works too)
# SHUTDOWN_GRACE_SECONDS=60         # on stop, how long the running job may finish before it is stopped and shown as interrupted
# READY_MIN_FREE_MB=500             # /readyz fails below this much free disk in the data folder, and no job starts (0 = no check)
# JOB_MAX_MINUTES=120               # a job that runs longer is stopped and recorded as failed (0 = no limit)
# RECORDINGS_MAX=2                  # recordings with a browser on this server at once, in all projects
# WORKER_STALE_SECONDS=90           # /readyz fails when no worker said it is alive for this long
# Scheduled backups of the whole database (off unless BACKUP_DIR is set; must not be the data folder). Each copy is checked by opening it.
# BACKUP_DIR=/var/backups/ai-testing-platform
# BACKUP_SCHEDULE=daily             # daily (02:30 UTC), daily@HH:MM (UTC), hourly, 6h, off
# BACKUP_KEEP=7
# BACKUP_UPLOAD_COMMAND=rclone copy "$BACKUP_FILE" remote:aitp-backups   # optional; run after each verified backup
