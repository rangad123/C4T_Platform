{
  "name": "ai-testing-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone autonomous AI testing platform: URL in, validated Playwright/API/Appium test suite out.",
  "type": "module",
  "bin": {
    "ai-test": "bin/ai-test.mjs",
    "ai-test-mcp": "bin/ai-test-mcp.mjs",
    "ai-test-agent": "bin/ai-test-agent.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ai-test": "tsx --env-file-if-exists=.env src/cli/index.ts",
    "mcp": "tsx --env-file-if-exists=.env src/mcp/index.ts",
    "agent": "node bin/ai-test-agent.mjs",
    "doctor": "tsx --env-file-if-exists=.env src/cli/doctor.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker-main.ts",
    "build:web": "vite build web",
    "build:runner": "node scripts/build-runner.mjs",
    "build:installer": "node scripts/build-installer.mjs",
    "dev:web": "vite web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:sample-app": "node examples/sample-app/server.mjs",
    "demo:e2e": "tsx --env-file-if-exists=.env scripts/e2e.ts",
    "test:ui:browsers": "node scripts/ui-browsers.mjs",
    "test:mobile:device": "vitest run tests/mobile-device.test.ts",
    "test:fast": "vitest run --config vitest.fast.config.ts",
    "test:browser": "node scripts/test-run.mjs browser",
    "test:phone": "node scripts/test-run.mjs phone",
    "test:release": "node scripts/test-run.mjs release"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@axe-core/playwright": "^4.13.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^10.1.10",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.52.0",
    "@taqwright/taqwright": "~1.2.0",
    "ai": "^6.0.0",
    "fastify": "^5.12.8",
    "fflate": "^0.8.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.4.0",
    "playwright": "^1.52.0",
    "typescript": "^5.8.0",
    "unpdf": "^1.8.1",
    "yaml": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.19.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.5"
  }
}
