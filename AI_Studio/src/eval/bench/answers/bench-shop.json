    "roles": [
        {
            "id": "visitor",
            "name": "Visitor"
        },
        {
            "id": "customer",
            "name": "Customer"
        }
    ],
    "rules": [
        {
            "defectId": "BS-01",
            "kind": "calculation",
            "statement": "Code SAVE10 takes 10% off the whole order subtotal (all cart lines together), rounded to the cent.",
            "requirement": {
                "id": "5.3",
                "line": 54
            },
            "workflows": [
                "cart-discount"
            ],
            "endpoints": [
                "POST /api/cart/discount",
                "GET /api/cart"
            ],
            "entities": [
                "cart",
                "discount-code"
            ]
        },
        {
            "defectId": "BS-02",
            "kind": "calculation",
            "statement": "The cart subtotal is the sum of all line totals (unit price times quantity).",
            "requirement": {
                "id": "4.9",
                "line": 46
            },
            "workflows": [
                "cart"
            ],
            "endpoints": [
                "GET /api/cart",
                "POST /api/cart/items"
            ],
            "entities": [
                "cart",
                "cart-line"
            ]
        },
        {
            "defectId": "BS-03",
            "kind": "constraint",
            "statement": "At most 10 of each item; a quantity above 10 is refused with a message.",
            "requirement": {
                "id": "4.6",
                "line": 43
            },
            "workflows": [
                "cart-quantity"
            ],
            "endpoints": [
                "POST /api/cart/items",
                "PATCH /api/cart/items/:productId"
            ],
            "entities": [
                "cart-line"
            ]
        },
        {
            "defectId": "BS-04",
            "kind": "constraint",
            "statement": "Registration refuses an email address that is not a valid email address.",
            "requirement": {
                "id": "2.3",
                "line": 20
            },
            "workflows": [
                "registration"
            ],
            "endpoints": [
                "POST /api/register"
            ],
            "entities": [
                "account"
            ]
        },
        {
            "defectId": "BS-05",
            "kind": "transition",
            "statement": "A Shipped order cannot be cancelled; the attempt is refused (409).",
            "requirement": {
                "id": "7.7",
                "line": 80
            },
            "workflows": [
                "order-lifecycle"
            ],
            "endpoints": [
                "POST /api/orders/:id/cancel"
            ],
            "entities": [
                "order"
            ]
        },
        {
            "defectId": "BS-06",
            "kind": "invariant",
            "statement": "Saved account changes (name, default address) are stored and shown after a reload.",
            "requirement": {
                "id": "8.3",
                "line": 89
            },
            "workflows": [
                "account-profile"
            ],
            "endpoints": [
                "PUT /api/profile",
                "GET /api/profile"
            ],
            "entities": [
                "account"
            ]
        },
        {
            "defectId": "BS-07",
            "kind": "workflow",
            "statement": "Placing an order empties the cart; placing again is refused because the cart is empty.",
            "requirement": {
                "id": "6.7",
                "line": 68
            },
            "workflows": [
                "checkout"
            ],
            "endpoints": [
                "POST /api/orders"
            ],
            "entities": [
                "cart",
                "order"
            ]
        },
        {
            "defectId": "BS-08",
            "kind": "permission",
            "statement": "A customer sees only their own orders; another person's order is 'Order not found' (404).",
            "requirement": {
                "id": "7.5",
                "line": 78
            },
            "workflows": [
                "order-history"
            ],
            "endpoints": [
                "GET /api/orders/:id"
            ],
            "entities": [
                "order"
            ]
        },
        {
            "defectId": "BS-09",
            "kind": "constraint",
            "statement": "Adding a product that does not exist to the cart answers 404 and leaves the cart unchanged.",
            "requirement": {
                "id": "4.4",
                "line": 41
            },
            "workflows": [
                "cart"
            ],
            "endpoints": [
                "POST /api/cart/items"
            ],
            "entities": [
                "product",
                "cart"
            ]
        },
        {
            "defectId": "BS-10",
            "kind": "workflow",
            "statement": "An order needs a delivery address from step 1; the review step without one goes back to step 1 and placing is refused.",
            "requirement": {
                "id": "6.4",
                "line": 65
            },
            "workflows": [
                "checkout"
            ],
            "endpoints": [
                "POST /api/checkout/address",
                "POST /api/orders"
            ],
            "entities": [
                "checkout",
                "order"
            ]
        },
        {
            "defectId": "BS-11",
            "kind": "calculation",
            "statement": "Shipping is free when the subtotal after discount is $50.00 or more.",
            "requirement": {
                "id": "5.6",
                "line": 57
            },
            "workflows": [
                "cart-shipping"
            ],
            "endpoints": [
                "GET /api/cart"
            ],
            "entities": [
                "cart"
            ]
        },
        {
            "defectId": "BS-12",
            "kind": "invariant",
            "statement": "The Orders page lists all of the customer's orders, newest first.",
            "requirement": {
                "id": "7.2",
                "line": 75
            },
            "workflows": [
                "order-history"
            ],
            "endpoints": [
                "GET /api/orders"
            ],
            "entities": [
                "order"
            ]
        }
    ]
}
