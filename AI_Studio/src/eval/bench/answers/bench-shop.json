{
    "app": "bench-shop",
    "version": "1",
    "review": "approved",
    "catalogueVersion": "2026-11-14.1",
    "requirementsDocument": "bench-shop-requirements.md",
    "screens": [
        {
            "id": "products",
            "path": "/",
            "name": "Products",
            "signIn": false,
            "roles": [
                "visitor",
                "customer"
            ]
        },
        {
            "id": "product",
            "path": "/products/:id",
            "name": "Product",
            "signIn": false,
            "roles": [
                "visitor",
                "customer"
            ]
        },
        {
            "id": "sign-in",
            "path": "/login",
            "name": "Sign in",
            "signIn": false,
            "roles": [
                "visitor"
            ]
        },
        {
            "id": "register",
            "path": "/register",
            "name": "Create account",
            "signIn": false,
            "roles": [
                "visitor"
            ]
        },
        {
            "id": "cart",
            "path": "/cart",
            "name": "Cart",
            "signIn": true,
            "roles": [
                "customer"
            ]
        },
        {
            "id": "checkout-address",
            "path": "/checkout",
            "name": "Checkout: delivery address",
            "signIn": true,
            "roles": [
                "customer"
            ]
        },
        {
            "id": "checkout-review",
            "path": "/checkout/review",
            "name": "Checkout: review and pay",
            "signIn": true,
            "roles": [
                "customer"
            ]
        },
        {
            "id": "orders",
            "path": "/orders",
            "name": "Orders",
            "signIn": true,
            "roles": [
                "customer"
            ]
        },
        {
            "id": "order",
            "path": "/orders/:id",
            "name": "Order",
            "signIn": true,
            "roles": [
                "customer"
            ]
        },
        {
            "id": "account",
            "path": "/account",
            "name": "Account",
            "signIn": true,
            "roles": [
                "customer"
            ]
        }
    ],
    "workflows": [
        {
            "id": "browse-products",
            "name": "Browse products",
            "screens": [
                "products",
                "product"
            ],
            "endpoints": [
                "GET /api/products",
                "GET /api/products/:id"
            ],
            "roles": [
                "visitor",
                "customer"
            ]
        },
        {
            "id": "registration",
            "name": "Create an account",
            "screens": [
                "register"
            ],
            "endpoints": [
                "POST /api/register"
            ],
            "roles": [
                "visitor"
            ]
        },
        {
            "id": "sign-in",
            "name": "Sign in and sign out",
            "screens": [
                "sign-in"
            ],
            "endpoints": [
                "POST /api/login",
                "POST /api/logout"
            ],
            "roles": [
                "visitor",
                "customer"
            ]
        },
        {
            "id": "cart",
            "name": "Add products to the cart and see its totals",
            "screens": [
                "product",
                "cart"
            ],
            "endpoints": [
                "POST /api/cart/items",
                "GET /api/cart",
                "DELETE /api/cart/items/:productId"
            ],
            "roles": [
                "customer"
            ]
        },
        {
            "id": "cart-quantity",
            "name": "Change quantities in the cart",
            "screens": [
                "product",
                "cart"
            ],
            "endpoints": [
                "POST /api/cart/items",
                "PATCH /api/cart/items/:productId"
            ],
            "roles": [
                "customer"
            ]
        },
        {
            "id": "cart-discount",
            "name": "Apply a discount code",
            "screens": [
                "cart"
            ],
            "endpoints": [
                "POST /api/cart/discount",
                "GET /api/cart"
            ],
            "roles": [
                "customer"
            ]
        },
        {
            "id": "cart-shipping",
            "name": "Shipping charge and free shipping",
            "screens": [
                "cart",
                "checkout-review"
            ],
            "endpoints": [
                "GET /api/cart"
            ],
            "roles": [
                "customer"
            ]
        },
        {
            "id": "checkout",
            "name": "Check out and place an order",
            "screens": [
                "cart",
                "checkout-address",
                "checkout-review",
                "order"
            ],
            "endpoints": [
                "POST /api/checkout/address",
                "POST /api/orders"
            ],
            "roles": [
                "customer"
            ]
        },
        {
            "id": "order-history",
            "name": "See your orders",
            "screens": [
                "orders",
                "order"
            ],
            "endpoints": [
                "GET /api/orders",
                "GET /api/orders/:id"
            ],
            "roles": [
                "customer"
            ]
        },
        {
            "id": "order-lifecycle",
            "name": "Pay or cancel an order",
            "screens": [
                "order"
            ],
            "endpoints": [
                "POST /api/orders/:id/pay",
                "POST /api/orders/:id/cancel"
            ],
            "roles": [
                "customer"
            ]
        },
        {
            "id": "account-profile",
            "name": "Change your name and default delivery address",
            "screens": [
                "account"
            ],
            "endpoints": [
                "GET /api/profile",
                "PUT /api/profile"
            ],
            "roles": [
                "customer"
            ]
        }
    ],
    "entities": [
        {
            "id": "product",
            "name": "Product",
            "fields": [
                "id",
                "name",
                "price",
                "description"
            ]
        },
        {
            "id": "account",
            "name": "Account",
            "fields": [
                "id",
                "name",
                "email",
                "password",
                "address"
            ]
        },
        {
            "id": "cart",
            "name": "Cart",
            "fields": [
                "lines",
                "code",
                "subtotal",
                "discount",
                "shipping",
                "total"
            ]
        },
        {
            "id": "cart-line",
            "name": "Cart line",
            "fields": [
                "productId",
                "name",
                "unitPrice",
                "quantity",
                "lineTotal"
            ]
        },
        {
            "id": "discount-code",
            "name": "Discount code",
            "fields": [
                "code",
                "percent"
            ]
        },
        {
            "id": "checkout",
            "name": "Checkout",
            "fields": [
                "address"
            ]
        },
        {
            "id": "order",
            "name": "Order",
            "fields": [
                "id",
                "status",
                "lines",
                "subtotal",
                "discount",
                "shipping",
                "total",
                "address",
                "placedAt"
            ]
        }
    ],
    "endpoints": [
        {
            "method": "GET",
            "path": "/api/products",
            "documented": true
        },
        {
            "method": "GET",
            "path": "/api/products/:id",
            "documented": true
        },
        {
            "method": "POST",
            "path": "/api/register",
            "documented": true
        },
        {
            "method": "POST",
            "path": "/api/login",
            "documented": true
        },
        {
            "method": "POST",
            "path": "/api/logout",
            "documented": true
        },
        {
            "method": "GET",
            "path": "/api/profile",
            "documented": true
        },
        {
            "method": "PUT",
            "path": "/api/profile",
            "documented": true
        },
        {
            "method": "GET",
            "path": "/api/cart",
            "documented": true
        },
        {
            "method": "POST",
            "path": "/api/cart/items",
            "documented": true
        },
        {
            "method": "PATCH",
            "path": "/api/cart/items/:productId",
            "documented": true
        },
        {
            "method": "DELETE",
            "path": "/api/cart/items/:productId",
            "documented": true
        },
        {
            "method": "POST",
            "path": "/api/cart/discount",
            "documented": true
        },
        {
            "method": "POST",
            "path": "/api/checkout/address",
            "documented": true
        },
        {
            "method": "GET",
            "path": "/api/orders",
            "documented": true
        },
        {
            "method": "POST",
            "path": "/api/orders",
            "documented": true
