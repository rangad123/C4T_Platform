        },
        {
            "method": "GET",
            "path": "/api/me",
            "documented": true
        },
        {
            "method": "GET",
            "path": "/api/notes",
            "documented": true
        },
        {
            "method": "POST",
            "path": "/api/notes",
            "documented": true
        },
        {
            "method": "GET",
            "path": "/api/notes/:id",
            "documented": true
        },
        {
            "method": "PUT",
            "path": "/api/notes/:id",
            "documented": true
        },
        {
            "method": "DELETE",
            "path": "/api/notes/:id",
            "documented": true
        },
        {
            "method": "POST",
            "path": "/api/notes/:id/share",
            "documented": true
        },
        {
            "method": "DELETE",
            "path": "/api/notes/:id/share/:userId",
            "documented": true
        },
        {
            "method": "GET",
            "path": "/api/admin/users",
            "documented": true
        },
        {
            "method": "PATCH",
            "path": "/api/admin/users/:id",
            "documented": true
        },
        {
            "method": "POST",
            "path": "/login",
            "documented": false
        },
        {
            "method": "POST",
            "path": "/register",
            "documented": false
        }
    ],
    "roles": [
        {
            "id": "visitor",
            "name": "Visitor"
        },
        {
            "id": "user",
            "name": "User"
        },
        {
            "id": "manager",
            "name": "Manager"
        },
        {
            "id": "admin",
            "name": "Admin"
        }
    ],
    "rules": [
        {
            "defectId": "BR-01",
            "kind": "permission",
            "statement": "Only the owner, people a note is shared with, managers and admins can read it; anyone else gets 'Note not found' (404).",
            "requirement": {
                "id": "4.2",
                "line": 44
            },
            "workflows": [
                "notes-read"
            ],
            "endpoints": [
                "GET /api/notes/:id"
            ],
            "entities": [
                "note"
            ]
        },
        {
            "defectId": "BR-02",
            "kind": "permission",
            "statement": "Only the owner can change a note; a person it is shared with gets 403, through the API too.",
            "requirement": {
                "id": "5.1",
                "line": 49
            },
            "workflows": [
                "notes-edit"
            ],
            "endpoints": [
                "PUT /api/notes/:id"
            ],
            "entities": [
                "note"
            ]
        },
        {
            "defectId": "BR-03",
            "kind": "permission",
            "statement": "Only admins can list people through the API; anyone else gets 403.",
            "requirement": {
                "id": "7.3",
                "line": 69
            },
            "workflows": [
                "admin-people"
            ],
            "endpoints": [
                "GET /api/admin/users"
            ],
            "entities": [
                "account"
            ]
        },
        {
            "defectId": "BR-04",
            "kind": "permission",
            "statement": "Only admins can change roles; managers included, anyone else gets 403.",
            "requirement": {
                "id": "7.4",
                "line": 70
            },
            "workflows": [
                "admin-roles"
            ],
            "endpoints": [
                "PATCH /api/admin/users/:id"
            ],
            "entities": [
                "account"
            ]
        },
        {
            "defectId": "BR-05",
            "kind": "invariant",
            "statement": "After signing out, the old session no longer works, even if its cookie value is sent again.",
            "requirement": {
                "id": "2.9",
                "line": 29
            },
            "workflows": [
                "session"
            ],
            "endpoints": [
                "POST /api/logout"
            ],
            "entities": [
                "session"
            ]
        },
        {
            "defectId": "BR-06",
            "kind": "permission",
            "statement": "After the owner stops sharing with a person, that person can no longer read the note.",
            "requirement": {
                "id": "6.6",
                "line": 62
            },
            "workflows": [
                "notes-share"
            ],
            "endpoints": [
                "DELETE /api/notes/:id/share/:userId",
                "GET /api/notes/:id"
            ],
            "entities": [
                "note"
            ]
        },
        {
            "defectId": "BR-07",
            "kind": "constraint",
            "statement": "Passwords need at least 8 characters; a shorter one is refused (400).",
            "requirement": {
                "id": "2.4",
                "line": 24
            },
            "workflows": [
                "registration"
            ],
            "endpoints": [
                "POST /api/register"
            ],
            "entities": [
                "account"
            ]
        },
        {
            "defectId": "BR-08",
            "kind": "constraint",
            "statement": "Every note needs a title; creating one without a title is refused with 400 and nothing is created.",
            "requirement": {
                "id": "3.4",
                "line": 37
            },
            "workflows": [
                "notes-create"
            ],
            "endpoints": [
                "POST /api/notes"
            ],
            "entities": [
                "note"
            ]
        }
    ]
}
