{
    "app": "bench-rbac",
    "version": "1",
    "review": "awaiting-owner",
    "catalogueVersion": "2026-11-14.1",
    "requirementsDocument": "bench-rbac-requirements.md",
    "screens": [
        {
            "id": "welcome",
            "path": "/",
            "name": "Welcome",
            "signIn": false,
            "roles": [
                "visitor"
            ]
        },
        {
            "id": "sign-in",
            "path": "/login",
            "name": "Sign in",
            "signIn": false,
            "roles": [
                "visitor"
            ]
        },
        {
            "id": "register",
            "path": "/register",
            "name": "Create account",
            "signIn": false,
            "roles": [
                "visitor"
            ]
        },
        {
            "id": "notes",
            "path": "/notes",
            "name": "Notes",
            "signIn": true,
            "roles": [
                "user",
                "manager",
                "admin"
            ]
        },
        {
            "id": "note-new",
            "path": "/notes/new",
            "name": "New note",
            "signIn": true,
            "roles": [
                "user",
                "manager",
                "admin"
            ]
        },
        {
            "id": "note",
            "path": "/notes/:id",
            "name": "Note",
            "signIn": true,
            "roles": [
                "user",
                "manager",
                "admin"
            ]
        },
        {
            "id": "people",
            "path": "/admin/users",
            "name": "People",
            "signIn": true,
            "roles": [
                "admin"
            ]
        },
        {
            "id": "account",
            "path": "/account",
            "name": "Account",
            "signIn": true,
            "roles": [
                "user",
                "manager",
                "admin"
            ]
        }
    ],
    "workflows": [
        {
            "id": "registration",
            "name": "Create an account",
            "screens": [
                "register"
            ],
            "endpoints": [
                "POST /api/register"
            ],
            "roles": [
                "visitor"
            ]
        },
        {
            "id": "session",
            "name": "Sign in and sign out",
            "screens": [
                "sign-in",
                "account"
            ],
            "endpoints": [
                "POST /api/login",
                "POST /api/logout",
                "GET /api/me"
            ],
            "roles": [
                "visitor",
                "user",
                "manager",
                "admin"
            ]
        },
        {
            "id": "notes-create",
            "name": "Create a note",
            "screens": [
                "notes",
                "note-new",
                "note"
            ],
            "endpoints": [
                "POST /api/notes"
            ],
            "roles": [
                "user",
                "manager",
                "admin"
            ]
        },
        {
            "id": "notes-read",
            "name": "List and read notes",
            "screens": [
                "notes",
                "note"
            ],
            "endpoints": [
                "GET /api/notes",
                "GET /api/notes/:id"
            ],
            "roles": [
                "user",
                "manager",
                "admin"
            ]
        },
        {
            "id": "notes-edit",
            "name": "Change a note",
            "screens": [
                "note"
            ],
            "endpoints": [
                "PUT /api/notes/:id"
            ],
            "roles": [
                "user",
                "manager",
                "admin"
            ]
        },
        {
            "id": "notes-delete",
            "name": "Delete a note",
            "screens": [
                "note"
            ],
            "endpoints": [
                "DELETE /api/notes/:id"
            ],
            "roles": [
                "user",
                "manager",
                "admin"
            ]
        },
        {
            "id": "notes-share",
            "name": "Share a note and stop sharing it",
            "screens": [
                "note"
            ],
            "endpoints": [
                "POST /api/notes/:id/share",
                "DELETE /api/notes/:id/share/:userId",
                "GET /api/notes/:id"
            ],
            "roles": [
                "user",
                "manager",
                "admin"
            ]
        },
        {
            "id": "admin-people",
            "name": "See everyone with an account",
            "screens": [
                "people"
            ],
            "endpoints": [
                "GET /api/admin/users"
            ],
            "roles": [
                "admin"
            ]
        },
        {
            "id": "admin-roles",
            "name": "Change someone's role",
            "screens": [
                "people"
            ],
            "endpoints": [
                "PATCH /api/admin/users/:id"
            ],
            "roles": [
                "admin"
            ]
        }
    ],
    "entities": [
        {
            "id": "account",
            "name": "Account",
            "fields": [
                "id",
                "name",
                "email",
                "password",
                "role"
            ]
        },
        {
            "id": "session",
            "name": "Session",
            "fields": [
                "sid",
                "userId",
                "ended"
            ]
        },
        {
            "id": "note",
            "name": "Note",
            "fields": [
                "id",
                "title",
                "body",
                "owner",
                "sharedWith"
            ]
        }
    ],
    "endpoints": [
