{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noUncheckedIndexedAccess": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "lib": ["ES2023", "DOM"],
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
    "exclude": ["node_modules", "references", "data", "web"]
}
