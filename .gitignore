# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
# Generated by Next on every dev start AND every build — and with DIFFERENT
# contents for each (`.next/dev/types` vs `.next/types`). Tracking it meant
# the file flipped back and forth depending on which command ran last, and on
# the deploy box the build's own rewrite left the tree dirty, which the
# deploy guard correctly refused to reset past. Next regenerates it before it
# is needed, and typecheck passes without it.
web/next-env.d.ts
out/
# Incremental TypeScript cache. Machine-specific, changes on every build, and
# was tracked — so every `npm run build` produced a spurious diff.
*.tsbuildinfo

# Environment — never commit. JWT_PRIVATE_KEY and the Neon credentials live here.
# Ignore every .env variant, then re-admit the committed templates.
.env
.env.*
!.env.example
!.env.test.example

# Keys and certificates
*.pem
*.key
!**/*.d.ts

