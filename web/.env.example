# ─── Public (inlined into the browser bundle at build time) ───────────────────
# Never put a secret in a NEXT_PUBLIC_* variable. It ships to every visitor.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base URL the browser hits for API calls. Trailing slash must be omitted.
# Same-origin (Vercel rewrite proxy): /api/v1  → Next forwards to API
# Cross-origin  (Vercel + Render split):  https://c4t-platform-api.onrender.com
NEXT_PUBLIC_API_BASE=/api/v1
# development | preview | production
# Anything other than "production" sets robots.txt to disallow everything and
# marks pages noindex, so staging cannot be crawled.
NEXT_PUBLIC_ENVIRONMENT=development

# ─── Server-only ──────────────────────────────────────────────────────────────

# Origin of the Express API for server-side fetches (Server Components, Server
# Actions). The browser reads `NEXT_PUBLIC_API_BASE` instead. In production
# this is the Render API URL.
API_ORIGIN=http://localhost:4000
